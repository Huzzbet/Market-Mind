{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Market Mind intelligence request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sources"
  ],
  "properties": {
    "focus": {
      "type": "string"
    },
    "marketContext": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "url",
          "publishedAt",
          "excerpt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,48}$"
          },
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "publishedAt": {
            "type": "string"
          },
          "publisher": {
            "type": "string"
          },
          "excerpt": {
            "type": "string"
          }
        }
      }
    }
  }
}
